<?xml version="1.0" encoding="utf-8"?>
<!-- Lift and zoom the focused item -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1.025" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1.025" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="100" android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:duration="100" android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" />
        </set>
    </item>
</selector>
