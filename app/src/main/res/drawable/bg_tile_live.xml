<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFF3D6E" android:endColor="#FFFF9A3D" />
            <corners android:radius="24dp" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#33FF3D6E" android:endColor="#33FF9A3D" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#8CFF3D6E" android:endColor="#59FF9A3D" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
