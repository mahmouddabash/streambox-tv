<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/sbAccent" android:endColor="?attr/sbAccent2" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/sbAccentDark" android:endColor="?attr/sbAccent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#337C5CFF" />
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="?attr/sbAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
