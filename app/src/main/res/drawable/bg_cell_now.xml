<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent" android:endColor="@color/accent2" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#407C5CFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
</selector>
