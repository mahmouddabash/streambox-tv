<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF7C5CFF" android:endColor="#FFD04DFF" />
            <corners android:radius="24dp" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#337C5CFF" android:endColor="#33D04DFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#8C7C5CFF" android:endColor="#59D04DFF" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
