<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim_left"
        android:tag="mirror" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim_bottom"
        android:alpha="0.8" />

<LinearLayout 
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="40dp">

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/poster"
            android:background="@drawable/bg_round_clip"
            android:layout_width="220dp"
            android:layout_height="320dp"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btnFav"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="0dp"
            android:text="☆ Favourite" />

        <Button
            android:id="@+id/btnDownload"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="0dp"
            android:text="⬇  Download episodes" />

        <Button
            android:id="@+id/btnTrailer"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="0dp"
            android:text="▶  Trailer"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/HeroTitle"
            android:textSize="34sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/gold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/seasons"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Loading episodes…"
            android:textColor="@color/text_dim" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodes"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
