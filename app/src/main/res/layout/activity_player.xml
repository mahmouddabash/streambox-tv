<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_buffering="when_playing" />

    <!-- Channel list over the live picture (OK) -->
    <LinearLayout
        android:id="@+id/chPanel"
        android:layout_width="460dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_side_panel"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chPanelTitle"
            style="@style/RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:text="◀ change group   •   OK watch   •   Back close"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chPanelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />
    </LinearLayout>

    <!-- Channel number being typed on the remote -->
    <TextView
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="36dp"
        android:background="@drawable/bg_badge"
        android:fontFamily="sans-serif-black"
        android:paddingStart="22dp"
        android:paddingTop="6dp"
        android:paddingEnd="22dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text"
        android:textSize="44sp"
        android:visibility="gone" />

    <!-- Paused / behind live indicator -->
    <TextView
        android:id="@+id/shift"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="36dp"
        android:background="@drawable/bg_badge"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:gravity="center"
        android:padding="38dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="56dp"
        android:paddingEnd="36dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ovTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/ovClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ovNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gold"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/ovProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ovNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ovHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="OK channel list   ▲▼ or 0-9 change channel   ⏯ pause   ◀▶ menu   INFO details"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
