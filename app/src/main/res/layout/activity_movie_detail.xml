<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim_left"
        android:tag="mirror" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim_bottom"
        android:alpha="0.7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="64dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                style="@style/Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movie" />

            <TextView
                android:id="@+id/title"
                style="@style/HeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:maxLines="7"
                android:textColor="#E6F5F7FF"
                android:textSize="16sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal">

                <Button android:id="@+id/btnPlay" style="@style/BtnPrimary" android:drawableStart="@drawable/ic_play_btn" android:text="Play" />
                <Button android:id="@+id/btnResume" style="@style/Btn" android:text="Resume" android:visibility="gone" />
                <Button android:id="@+id/btnTrailer" style="@style/Btn" android:text="▶  Trailer" android:visibility="gone" />
                <Button android:id="@+id/btnDownload" style="@style/Btn" android:text="⬇  Download" />
                <Button android:id="@+id/btnFav" style="@style/Btn" android:text="+ My list" />
            </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/castTitle"
                style="@style/RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Cast"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/poster"
            android:layout_width="250dp"
            android:layout_height="375dp"
            android:layout_marginStart="56dp"
            android:background="@drawable/bg_round_clip"
            android:elevation="16dp"
            android:scaleType="centerCrop" />
    </LinearLayout>
</FrameLayout>
